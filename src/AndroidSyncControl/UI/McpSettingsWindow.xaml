<Window x:Class="AndroidSyncControl.UI.McpSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:AndroidSyncControl.UI.Controls"
        Title="{DynamicResource Str.Mcp.Title}"
        Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Icon="/Resources/appicon.ico"
        FontFamily="Segoe UI" FontSize="13"
        Background="{DynamicResource Brush.Window.Background}"
        Foreground="{DynamicResource Brush.Text.Primary}"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <Style x:Key="ReadOnlyField" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource Brush.Surface.Background}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Surface.BorderBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource Brush.Text.Primary}"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,12,8"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}"/>
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <CheckBox Grid.ColumnSpan="2" Content="{DynamicResource Str.Mcp.Enable}" IsChecked="{Binding McpEnabled}"/>
        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Margin="0,6,0,12" TextWrapping="Wrap"
                   Text="{DynamicResource Str.Tip.Mcp}" Foreground="{DynamicResource Brush.Text.Secondary}"/>

        <TextBlock Grid.Row="2" Text="{DynamicResource Str.Mcp.Port}" Style="{StaticResource FieldLabel}"/>
        <ctrl:NumericUpDown Grid.Row="2" Grid.Column="1" Width="90" HorizontalAlignment="Left" Margin="0,0,0,8"
                            Minimum="1024" Maximum="65535" Value="{Binding McpPort}" Increment="1"
                            ToolTip="{DynamicResource Str.Tip.McpPort}"/>

        <TextBlock Grid.Row="3" Text="{DynamicResource Str.Mcp.Status}" Style="{StaticResource FieldLabel}"/>
        <TextBox Grid.Row="3" Grid.Column="1" Margin="0,0,0,8" Style="{StaticResource ReadOnlyField}"
                 Text="{Binding McpStatus, Mode=OneWay}"/>

        <TextBlock Grid.Row="4" Text="{DynamicResource Str.Mcp.Token}" Style="{StaticResource FieldLabel}"/>
        <TextBox Grid.Row="4" Grid.Column="1" Margin="0,0,0,16" Style="{StaticResource ReadOnlyField}"
                 Text="{Binding McpToken, Mode=OneWay}"/>

        <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{DynamicResource Str.Btn.McpCopy}" Style="{StaticResource AccentButton}" Click="btn_copy_Click"
                    IsEnabled="{Binding McpEnabled}" ToolTip="{DynamicResource Str.Tip.McpCopy}" Margin="0,0,8,0"/>
            <Button Content="{DynamicResource Str.Btn.McpNewToken}" Click="btn_newToken_Click"
                    ToolTip="{DynamicResource Str.Tip.McpNewToken}" Margin="0,0,8,0"/>
            <Button Content="{DynamicResource Str.Btn.Close}" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
